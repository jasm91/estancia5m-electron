# Copia este archivo a .env y rellena los valores reales

# --- Servidor ---
PORT=3000
NODE_ENV=production

# --- PostgreSQL (Railway lo provee como DATABASE_URL automáticamente) ---
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Token de admin para acceder al panel ---
# Inventa uno aleatorio largo. Lo usas en la URL del panel.
ADMIN_TOKEN=sgventas-admin-2026-CAMBIA-ESTO-poR_alGo_aLeATorIo

# --- Token compartido con n8n ---
# Mismo valor en n8n para autenticación bidireccional
